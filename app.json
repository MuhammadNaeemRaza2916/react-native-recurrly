{
  "expo": {
    "name": "Recurrly",
    "slug": "react_native_recurrly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/logo.png",
    "scheme": "reactnativerecurrly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.raza.recurrly",
      "supportsTablet": true,
      "icon": "./assets/images/splash-pattern.png"
    },
    "android": {
      "package": "com.raza.recurrly",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/splash-pattern.png",
        "monochromeImage": "./assets/images/splash-pattern.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ea7a53",
          "image": "./assets/images/splash-pattern.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
            "./assets/fonts/PlusJakartaSans-Light.ttf"
          ]
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
